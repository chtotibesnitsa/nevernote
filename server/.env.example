# Set these as Edge Function secrets: supabase secrets set --env-file server/.env
# Any OpenAI-compatible endpoint works. OpenRouter + Gemini Flash Lite is the cheapest good option.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
# Optional stronger model for Pro "Ask your notes".
LLM_PRO_MODEL=
# Shared secrets for the scheduled nightly batch and the RevenueCat webhook.
CRON_SECRET=
REVENUECAT_WEBHOOK_SECRET=
