{
  "name": "notelater",
  "private": true,
  "description": "Free, open source, offline class note taker: every word, every speaker, notes and due dates on your phone.",
  "license": "MIT",
  "workspaces": ["packages/*", "apps/web", "apps/desktop"],
  "scripts": {
    "test": "npm run test -w @notelater/core",
    "dev:web": "npm run dev -w @notelater/web",
    "dev:desktop": "npm run dev -w @notelater/desktop",
    "build:web": "npm run build -w @notelater/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
