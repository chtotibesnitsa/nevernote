{
  "name": "@nevernote/desktop",
  "productName": "Nevernote",
  "version": "0.1.0",
  "description": "Every word, every speaker, offline. Free and open source class notes.",
  "author": "Aleks <aleksander@lucenko.com>",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts src/engine-worker.ts --bundle --platform=node --format=cjs --outdir=dist --out-extension:.js=.cjs --external:electron --external:sherpa-onnx-node",
    "build:renderer": "npm run build -w @nevernote/web -- --base ./ --outDir ../desktop/renderer --mode desktop",
    "build": "npm run build:renderer && npm run build:main",
    "dev": "npm run build:main && NEVERNOTE_DEV_URL=http://localhost:5173 electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test:engine": "tsx test/run-engine.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8",
    "@nevernote/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "app.nevernote.desktop",
    "productName": "Nevernote",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nevernote listens to your class so it can write down every word. Audio never leaves your Mac."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chtotibesnitsa",
        "repo": "nevernote"
      }
    ]
  }
}
